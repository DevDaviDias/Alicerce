rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Cada usuário só lê/escreve dentro da própria pasta users/{uid}/**
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024; // limite de 5MB por arquivo
    }
  }
}
