# Copie este arquivo para .env.local e preencha com os dados do seu projeto Firebase
# (Firebase Console > Configurações do projeto > Seus apps > SDK setup and configuration)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: se for usar login com Google (mesmo client ID que você já usa no mobile
# pode ser reaproveitado criando um novo tipo de credencial "Web" no Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID_WEB=
